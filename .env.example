# Copy to .env and adjust. Never commit the real .env file.

# --- Database (LAMP server, same MySQL instance as the existing site) ---
DAT_DB_HOST=127.0.0.1
DAT_DB_PORT=3306
DAT_DB_NAME=visionary_db
DAT_DB_USER=root
DAT_DB_PASS=CHANGE_ME

# --- Portal ---
# Leave PORTAL_BASE_URL empty to auto-detect from the request.
# Set it explicitly for NFC/QR payloads, e.g. https://www.eurohydraulicparts.com/nfc
PORTAL_BASE_URL=
PORTAL_NAME=Digital Asset Tag Portal

# Language shown when the visitor has no preference (en|de)
PORTAL_DEFAULT_LANG=en

# Maximum anonymous messages per IP per asset per hour
PORTAL_MESSAGE_RATE_LIMIT=5

# Days an anonymous message is kept before it can be purged
PORTAL_MESSAGE_RETENTION_DAYS=90

# Maximum upload size in bytes (10 MB)
PORTAL_MAX_UPLOAD_BYTES=10485760
